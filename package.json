{
    "name": "@bitsocial/ai-moderation-challenge",
    "version": "0.3.1",
    "description": "Bitsocial AI moderation challenge implementation for PKC",
    "keywords": [
        "bitsocial",
        "pkc",
        "challenge",
        "moderation",
        "ai"
    ],
    "author": "Bitsocial Forge",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitsocialnet/ai-moderation-challenge.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "yarn clean && node esbuild.config.js && tsc -p tsconfig.json --emitDeclarationOnly",
        "clean": "rm -rf dist",
        "llms:generate": "node scripts/generate-llms-files.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage.enabled",
        "coverage:badge": "node scripts/write-coverage-badge.mjs",
        "type-check": "tsc -p tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "release": "HUSKY=0 release-it --config .release-it.json"
    },
    "dependencies": {
        "@pkcprotocol/pkc-logger": "0.1.0",
        "zod": "4.3.5"
    },
    "devDependencies": {
        "@pkcprotocol/pkc-js": "0.0.85",
        "@release-it/conventional-changelog": "10.0.1",
        "@vitest/coverage-v8": "4.1.10",
        "esbuild": "0.28.1",
        "prettier": "3.8.1",
        "release-it": "19.2.3",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    },
    "resolutions": {
        "@conventional-changelog/git-client@npm:^1.0.0": "npm:2.7.0",
        "@libp2p/gossipsub": "16.0.4",
        "@libp2p/kad-dht@npm:^16.2.0": "npm:16.2.6",
        "@protobufjs/utf8@npm:^1.1.0": "npm:1.1.1",
        "axios@npm:^1.7.2": "npm:1.18.1",
        "basic-ftp@npm:^5.0.2": "npm:5.3.1",
        "ip-address@npm:^10.0.1": "npm:10.3.1",
        "protobufjs@npm:^6.10.2": "npm:7.6.5",
        "esbuild@npm:^0.27.0": "npm:0.28.1",
        "form-data@npm:^4.0.5": "npm:4.0.6",
        "tar@npm:^7.5.4": "npm:7.5.22",
        "undici@npm:6.22.0": "npm:6.28.0",
        "undici@npm:6.25.0": "npm:6.28.0",
        "undici@npm:^6.25.0": "npm:6.28.0",
        "nanoid@npm:^3.3.16": "npm:3.3.18",
        "nanoid@npm:^5.0.7": "npm:5.1.16",
        "nanoid@npm:^5.1.5": "npm:5.1.16",
        "undici@npm:7.24.7": "npm:7.29.0",
        "undici@npm:^7.16.0": "npm:7.29.0",
        "undici@npm:^7.19.0": "npm:7.29.0",
        "undici@npm:^8.0.3": "npm:8.9.0",
        "uuid@npm:^11.0.0": "npm:11.1.1",
        "uuid@npm:13.0.0": "npm:13.0.1",
        "ws@npm:8.20.0": "npm:8.21.0",
        "ws@npm:^8.5.0": "npm:8.21.0",
        "ws@npm:^8.18.3": "npm:8.21.0"
    },
    "packageManager": "yarn@4.17.1"
}
